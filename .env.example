# Arquivo de Configuração - EXEMPLO
# Copie este arquivo para .env e preencha com valores reais
# IMPORTANTE: Nunca commitar este arquivo com valores reais no Git

# ============================================
# AMBIENTE
# ============================================
ENVIRONMENT=Development
DEBUG=true

# ============================================
# BANCO DE DADOS (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=phishing_detection
DB_USER=app_user
DB_PASSWORD=sua_senha_segura_aqui
DB_POOL_SIZE=20
DB_TIMEOUT=30

# ============================================
# SERVIDOR DE E-MAIL (IMAP - Recebimento)
# ============================================
EMAIL_IMAP_HOST=seu-servidor-imap.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=detector@empresa.com
EMAIL_IMAP_PASSWORD=senha_email_aqui
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_CHECK_INTERVAL_SECONDS=60
EMAIL_IMAP_MAILBOX=INBOX

# ============================================
# SERVIDOR DE E-MAIL (SMTP - Notificações)
# ============================================
EMAIL_SMTP_HOST=seu-servidor-smtp.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=notificacoes@empresa.com
EMAIL_SMTP_PASSWORD=senha_smtp_aqui
EMAIL_SMTP_USE_TLS=true
EMAIL_SMTP_SENDER=sistema-phishing@empresa.com
EMAIL_SMTP_SENDER_NAME=Sistema de Detecção de Phishing

# ============================================
# SERVIÇO BACKEND (C# .NET)
# ============================================
API_HOST=localhost
API_PORT=5001
API_URL=https://seu-dominio.com/api
API_CORS_ORIGINS=http://localhost:3000,https://seu-dominio.com
API_JWT_SECRET=sua_chave_secreta_jwt_muito_longa_e_aleatoria
API_JWT_EXPIRES_IN_HOURS=24
API_LOG_LEVEL=Information

# ============================================
# SERVIÇO MACHINE LEARNING (Python)
# ============================================
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=5000
ML_SERVICE_URL=http://localhost:5000
ML_MODEL_PATH=./models
ML_MODELS_VERSION=1.0
ML_MIN_CONFIDENCE=0.5
ML_LOG_LEVEL=INFO

# ============================================
# FRONTEND (React)
# ============================================
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_ML_SERVICE_URL=http://localhost:5000
REACT_APP_ENV=development
REACT_APP_LOG_LEVEL=debug

# ============================================
# SEGURANÇA
# ============================================
SECURITY_CORS_ENABLED=true
SECURITY_HTTPS_ONLY=false
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW_MS=900000

# Para Produção: Use Azure Key Vault ou similar
# AZURE_KEYVAULT_URL=https://seu-vault.vault.azure.net/

# ============================================
# POWER BI
# ============================================
POWERBI_TENANT_ID=seu-tenant-id
POWERBI_CLIENT_ID=seu-client-id
POWERBI_CLIENT_SECRET=seu-client-secret
POWERBI_WORKSPACE_ID=seu-workspace-id
POWERBI_DATASET_ID=seu-dataset-id

# ============================================
# DATASETS EXTERNOS (Opcional)
# ============================================
# Sting9 Research Initiative (registro em sting9.org -> login -> JWT)
STING9_API_BASE=https://api.sting9.org/api/v1
STING9_TOKEN=seu_jwt_sting9_aqui
STING9_API_KEY=sua_chave_sting9_aqui
# Caminho de um export JSON já baixado (vazio = usa o mais recente em ml/data/raw/)
STING9_EXPORT_PATH=
# Phishing Email Dataset (Kaggle)
KAGGLE_USERNAME=seu-usuario-kaggle
KAGGLE_KEY=sua-chave-kaggle-aqui
KAGGLE_DATASET_SLUG=owner/phishing-email-dataset

# ============================================
# LOGGING E MONITORAMENTO
# ============================================
LOG_PATH=./logs
LOG_MAX_SIZE_MB=100
LOG_RETENTION_DAYS=90
SENTRY_DSN=

# ============================================
# MÉTRICAS
# ============================================
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================
# CONFORMIDADE LGPD
# ============================================
GDPR_DATA_RETENTION_DAYS=90
GDPR_CONSENT_REQUIRED=true
GDPR_ANONYMIZE_AFTER_DAYS=60
